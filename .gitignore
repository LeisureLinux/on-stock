manual_downloaded_data

# 抓取原料（外媒标题/中译/摘要），是付费内容的**源数据**：
# 它在仓库里等于把 data/news/*.json 直接公开（raw / jsDelivr / Pages 源站都能读）。
# 本机由 scripts/fetch_news.py 读写，不进 git。
data/

# 付费构建产物（latest / news 归档页），上传到 Cloudflare KV 而非 Pages。
# 见 scripts/publish_paid.py 与 tools/cf-paywall/worker.js。
dist_paid/

# Python 字节码缓存
__pycache__/
*.py[cod]

# Cloudflare Worker / 付费墙运维代码：含账号库、KV namespace id、管理员标识，
# 与站点构建（build.py / GitHub Actions）无关，不进公开仓库。本地保留即可。
tools/

# Cloudflare Worker 本地运行态（wrangler dev / miniflare 产物）
.wrangler/

# 本机 cron 运行日志与锁文件
/logs/
